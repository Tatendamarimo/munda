# Fake, non-secret config for the local end-to-end test against Firebase emulators (vite --mode e2e).
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-munda.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-munda
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true

# Keep end-to-end runs off the real project: no App Check site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
