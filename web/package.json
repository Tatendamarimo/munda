{
  "name": "munda-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e:emulators": "cd ../firebase/rules-test && npx firebase emulators:start --only auth,firestore --project demo-munda --config ../../firebase.json",
    "e2e:serve": "vite --mode e2e --host 127.0.0.1 --port 5173 --strictPort",
    "e2e": "node e2e/smoke.mjs",
    "export:i18n": "node scripts/export-i18n.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
